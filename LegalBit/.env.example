# Plantilla del archivo de configuracion.
#
#   1. Copia este archivo como  LegalBit/.env
#   2. Rellena los valores
#
# LegalBit/.env NUNCA se sube a git: contiene las llaves reales.
# Las de produccion viven solo en el servidor.

# ---------- Entorno ----------
# En local: True.  En el servidor: False, siempre.
DEBUG=True

# Cualquier cadena larga y aleatoria. Para local no importa cual.
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# ---------- Base de datos ----------
DB_NAME=legalbit
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------- Proveedores externos ----------
# DEJAR VACIAS EN LOCAL. Con valores reales, cada prueba gasta dinero
# y consulta datos de personas reales desde tu equipo.
NUFI_API_KEY=
MOFFIN_APIKEY=
MOX_KEY=
BLINKID_APIKEY=

# ---------- Firma electronica ----------
WEETRUST_USER_ID=
WEETRUST_API_KEY=
WEETRUST_API_URL=https://api.weetrust.mx

# ---------- Mensajeria ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS=
TWILIO_WHATSAPP=

# ---------- Cobros ----------
STRIPE_SECRET_KEY=
STRIPE_REDIRECT_UR=http://127.0.0.1:8000
STRIPE_WEBHOOK_SECRET=

# ---------- Correo ----------
EMAIL_USER=
EMAIL_PASS=
FROM_EMAIL=local@avalo.mx
