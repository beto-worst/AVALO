version: '3.9'
services:
  db:
    image: mariadb
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASS}
      MYSQL_DATABASE: LegalBit
      MYSQL_USER: legalbit
      MYSQL_PASSWORD: ${DB_PASS}

  web:
    build: .
    command: python manage.py runserver 0.0.0.0:80
    volumes:
      - .:/code
      - ./staticfiles:/code/staticfle
    ports:
      - "80:80"
    depends_on:
      - db
